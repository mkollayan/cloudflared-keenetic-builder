#!/bin/sh

PATH=/opt/bin:/opt/sbin:/opt/home:/sbin:/bin:/usr/sbin:/usr/bin
export PATH

PIDFILE="/opt/var/run/cloudflared.pid"
CLOUDFLARED="/opt/home/cloudflared"
LOGFILE="/opt/var/log/cloudflared.log"
TOKENFILE="/opt/etc/cloudflared.token"

mkdir -p /opt/var/run /opt/var/log /opt/etc

read_pid() {
  [ -f "$PIDFILE" ] || return 1
  pid="$(cat "$PIDFILE" 2>/dev/null)"
  case "$pid" in
    ''|*[!0-9]*) return 1 ;;
  esac
  echo "$pid"
}

cloudflared_status() {
  pid="$(read_pid)" || return 1
  kill -0 "$pid" 2>/dev/null
}

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null) $*" >>"$LOGFILE"
}

wait_for_time() {
  # NTP oturmadan TLS sorun çıkartabiliyor. Maks 90 sn bekle.
  i=0
  while [ $i -lt 90 ]; do
    y="$(date +%Y 2>/dev/null)"
    case "$y" in
      ''|*[!0-9]*) ;;
      *)
        [ "$y" -ge 2020 ] && return 0
        ;;
    esac
    i=$((i+1))
    sleep 1
  done
  return 0  # Zorlamayalım; bazı sistemlerde date formatı değişebilir
}

wait_for_wan() {
  # Maks 60 sn
  i=0
  while [ $i -lt 60 ]; do
    ping -c1 -W1 1.1.1.1 >/dev/null 2>&1 && return 0
    i=$((i+1))
    sleep 1
  done
  return 0
}

start() {
  if cloudflared_status; then
    echo "cloudflared already running (PID $(read_pid))"
    return 0
  fi

  rm -f "$PIDFILE"

  [ -x "$CLOUDFLARED" ] || { echo "cloudflared binary yok/çalıştırılamıyor: $CLOUDFLARED"; return 1; }
  [ -f "$TOKENFILE" ] || { echo "token dosyası yok: $TOKENFILE"; return 1; }

  TOKEN="$(sed 's/\r//g' "$TOKENFILE" 2>/dev/null | head -n 1)"
  [ -n "$TOKEN" ] || { echo "token boş görünüyor"; return 1; }

  echo "Starting cloudflared..."
  log_msg "Starting cloudflared"
  wait_for_time
  wait_for_wan

  "$CLOUDFLARED" --no-autoupdate --protocol http2 --pidfile="$PIDFILE" \
    tunnel run --token "$TOKEN" >>"$LOGFILE" 2>&1 &

  # PID dosyası oluşsun diye maks 10 sn bekle.
  j=0
  while [ $j -lt 10 ]; do
    cloudflared_status && { echo "cloudflared started"; return 0; }
    j=$((j+1))
    sleep 1
  done
  echo "cloudflared failed (pidfile gelmedi), check $LOGFILE"
  log_msg "cloudflared failed to create pidfile"
  return 1
}

stop() {
  if cloudflared_status; then
    pid="$(read_pid)"
    echo "Stopping cloudflared..."
    log_msg "Stopping cloudflared PID $pid"
    kill "$pid" 2>/dev/null

    i=0
    while [ $i -lt 10 ]; do
      cloudflared_status || break
      i=$((i+1))
      sleep 1
    done

    cloudflared_status && kill -9 "$pid" 2>/dev/null
    rm -f "$PIDFILE"
  else
    rm -f "$PIDFILE"
    echo "cloudflared is not running"
  fi
}

status() {
  if cloudflared_status; then
    echo "cloudflared is running (PID $(read_pid))"
  else
    echo "cloudflared is not running"
  fi
}

restart() { stop; sleep 2; start; }

case "$1" in
  start|stop|restart|status) "$1" ;;
  *) echo "Usage: $0 {start|stop|restart|status}" ;;
esac

